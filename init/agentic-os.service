[Unit]
Description=Agentic OS First Boot Setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/agentic-os/.first-boot-complete

[Service]
Type=oneshot
ExecStart=/usr/local/share/agentic-os/init/agentic-os-init.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
