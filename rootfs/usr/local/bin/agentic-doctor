#!/usr/bin/env bash
# Agentic OS system health checker
# Run `claude-doctor` to verify your Agentic OS environment

BOLD='\033[1m'; GREEN='\033[0;32m'; RED='\033[0;31m'
YELLOW='\033[1;33m'; CYAN='\033[0;36m'; RESET='\033[0m'

PASS="${GREEN}✓${RESET}"
FAIL="${RED}✗${RESET}"
WARN="${YELLOW}⚠${RESET}"

check() {
    local name="$1" cmd="$2" expected_pattern="${3:-}"
    local result
    result=$(eval "$cmd" 2>&1)
    local status=$?
    if [[ $status -eq 0 ]]; then
        if [[ -n "$expected_pattern" ]]; then
            if echo "$result" | grep -q "$expected_pattern"; then
                printf "  %b %-30s %s\n" "${PASS}" "$name" "${result:0:40}"
            else
                printf "  %b %-30s %s\n" "${WARN}" "$name" "found but unexpected: ${result:0:30}"
            fi
        else
            printf "  %b %-30s %s\n" "${PASS}" "$name" "${result:0:40}"
        fi
    else
        printf "  %b %-30s %s\n" "${FAIL}" "$name" "not found or failed"
    fi
}

check_env() {
    local name="$1" var="$2"
    if [[ -n "${!var}" ]]; then
        printf "  %b %-30s %s\n" "${PASS}" "$name" "set (${#!var} chars)"
    else
        printf "  %b %-30s %s\n" "${FAIL}" "$name" "NOT SET"
    fi
}

echo ""
echo "${BOLD}╔══════════════════════════════════════════════╗${RESET}"
echo "${BOLD}║         Agentic OS Health Report              ║${RESET}"
echo "${BOLD}╚══════════════════════════════════════════════╝${RESET}"
echo ""

echo "${BOLD}── System ──────────────────────────────────────${RESET}"
check "OS Release"      "cat /etc/agentic-os-release 2>/dev/null | head -1" "Agentic OS"
check "Kernel"          "uname -r"
check "Architecture"    "uname -m" "x86_64"
check "Hostname"        "hostname"
check "Memory"          "free -h | awk 'NR==2{print \$2 \" total\"}'"
check "Disk"            "df -h / | awk 'NR==2{print \$4 \" free\"}'"
check "Uptime"          "uptime -p 2>/dev/null || uptime"

echo ""
echo "${BOLD}── Core Tools ──────────────────────────────────${RESET}"
check "Claude Code"     "claude --version 2>&1 | head -1"
check "Node.js"         "node --version"
check "Bun"             "bun --version" "1\."
check "Python"          "python --version" "3\."
check "uv (Python pkg)" "uv --version"
check "Git"             "git --version"
check "curl"            "curl --version | head -1"
check "jq"              "jq --version"

echo ""
echo "${BOLD}── Agentic OS Tools ─────────────────────────────${RESET}"
check "hermes"          "which hermes"
check "blackbox"        "which blackbox"
check "skills"          "which skills"
check "agentic-os-setup" "which agentic-os-setup"

echo ""
echo "${BOLD}── Optional AI Tools ───────────────────────────${RESET}"
for tool in opencode codex aider goose sweagent openclaw openhands; do
    if command -v "$tool" &>/dev/null; then
        printf "  %b %-30s %s\n" "${PASS}" "$tool" "$(command -v $tool)"
    else
        printf "  %b %-30s %s\n" "${WARN}" "$tool" "not installed"
    fi
done
echo "  ${DIM}→ Run 'agentic-os-setup' to add more tools${RESET}"

echo ""
echo "${BOLD}── Environment ─────────────────────────────────${RESET}"
check_env "ANTHROPIC_API_KEY"   "ANTHROPIC_API_KEY"
check_env "CLAUDE_OS"           "CLAUDE_OS"
check_env "CLAUDE_SKILLS_DIR"   "CLAUDE_SKILLS_DIR"
check_env "HERMES_MODEL"        "HERMES_MODEL"
check_env "BLACKBOX_MODEL"      "BLACKBOX_MODEL"

echo ""
echo "${BOLD}── Skills ──────────────────────────────────────${RESET}"
SKILLS_DIR="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
if [[ -d "$SKILLS_DIR" ]]; then
    skill_count=$(find "$SKILLS_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    printf "  %b %-30s %s\n" "${PASS}" "Claude skills" "${skill_count} installed"
else
    printf "  %b %-30s %s\n" "${WARN}" "Claude skills" "directory not found: $SKILLS_DIR"
fi

GSTACK="${GSTACK_SKILLS:-/usr/local/share/agentic-os/skills/gstack}"
if [[ -d "$GSTACK" ]]; then
    gcount=$(find "$GSTACK" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    printf "  %b %-30s %s\n" "${PASS}" "gstack skills" "${gcount} installed"
else
    printf "  %b %-30s %s\n" "${WARN}" "gstack skills" "not found"
fi

echo ""
echo "${BOLD}── Network ─────────────────────────────────────${RESET}"
check "Internet"        "curl -s --max-time 5 https://api.anthropic.com/v1/models -o /dev/null -w '%{http_code}'" "200\|401"
check "DNS"             "host api.anthropic.com 2>&1 | head -1"

echo ""
echo "${BOLD}── Claude Config ───────────────────────────────${RESET}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
check "CLAUDE.md"       "test -f $CLAUDE_DIR/CLAUDE.md && echo 'present'"
check "settings.json"   "test -f $CLAUDE_DIR/settings.json && echo 'present'"

echo ""
echo "────────────────────────────────────────────────"
echo "${BOLD}Agentic OS $(cat /etc/agentic-os-release 2>/dev/null | grep VERSION= | cut -d= -f2 | tr -d '"')${RESET}  |  $(date)"
echo ""
