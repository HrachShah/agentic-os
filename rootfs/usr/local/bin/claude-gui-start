#!/bin/sh
# Launch Claude OS GUI — called at boot by OpenRC

GUI_DIR="/usr/local/share/claude-os/gui"
LOG="/var/log/claude-gui.log"

echo "[claude-gui] Starting backend server..." >> "$LOG"
cd "$GUI_DIR"
node server/index.js >> "$LOG" 2>&1 &

# Wait for backend
sleep 2

# Serve the built GUI dist with a simple static server or Chromium kiosk
if command -v chromium-browser >/dev/null 2>&1; then
  CHROMIUM=chromium-browser
elif command -v chromium >/dev/null 2>&1; then
  CHROMIUM=chromium
fi

if [ -n "$CHROMIUM" ] && [ -f "$GUI_DIR/dist/index.html" ]; then
  echo "[claude-gui] Launching Chromium kiosk..." >> "$LOG"
  export DISPLAY=:0
  Xvfb :0 -screen 0 1920x1080x24 &
  sleep 1
  $CHROMIUM \
    --kiosk \
    --no-sandbox \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=TranslateUI \
    --app="file://$GUI_DIR/dist/index.html" \
    >> "$LOG" 2>&1 &
else
  # Dev mode: vite dev server
  echo "[claude-gui] Running in dev mode (vite)..." >> "$LOG"
  cd "$GUI_DIR"
  bun run dev >> "$LOG" 2>&1 &
fi
