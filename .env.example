# Agentic OS Environment Variables

# Your Anthropic API key (required for Claude Code)
ANTHROPIC_API_KEY=sk-ant-...

# Path to .claude directory (default: ~/.claude)
CLAUDE_HOME=~/.claude

# Workspace directory to monitor (default: ~/)
WORKSPACE=~/

# Port for the backend server (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production
